# 백엔드 전용 환경변수. 복사해서 backend/.env 로 만들어 쓰고, .env 는 커밋하지 않는다.
# 프론트 값은 frontend/.env 에 따로 둔다. 루트에는 .env 를 만들지 않는다.
#
# [사용 중] = 지금 코드가 실제로 읽는 값
# [예정]   = 스키마·아키텍처상 필요한 값. 해당 기능을 붙일 때 application.yaml 에 연결한다.

# ── PostgreSQL ──────────────────────────────────────────────
# [사용 중] application.yaml 의 datasource. 컨테이너는 루트 docker-compose.yml 이 띄운다.
# compose 는 루트 .env 가 없으면 자기 기본값(antenna/antenna/antenna:5432)을 쓴다.
# 아래 값을 바꾸면 compose 쪽 기본값도 같이 바꿔야 서버와 컨테이너가 어긋나지 않는다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=antenna
DB_USER=antenna
DB_PASSWORD=antenna

# ── Redis ───────────────────────────────────────────────────
# [사용 중] refresh token 회전, 랭킹 스냅샷 캐시.
REDIS_HOST=localhost
REDIS_PORT=6379

# ── OAuth 2.0 로그인 ─────────────────────────────────────────
# [사용 중] 자체 회원가입은 만들지 않는다. 구글·SSAFY 두 종류뿐.
# 구글은 Cloud Console > 인증 플랫폼 > 클라이언트에서 발급한다.
# 리디렉션 URI 는 프론트 콜백(http://localhost:5173/oauth/callback/google)으로 등록한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [사용 중] 개발자센터 [내 어플리케이션] > [서비스 설정] > [SSAFY 로그인] 의 값이다.
# OPEN API Key 와 다른 자격증명이니 헷갈리지 말 것. Secret 에는 만료일이 있다.
# 주소·응답 필드명은 문서로 확정돼 application.yaml 에 상수로 들어갔다 —
# 환경마다 달라지는 값이 아니라 여기서 받지 않는다.
SSAFY_CLIENT_ID=
SSAFY_CLIENT_SECRET=

# ── 자체 발급 JWT ────────────────────────────────────────────
# [사용 중] access token 은 서버에 저장하지 않고, refresh token 만 Redis 에 둔다.
# JWT_SECRET 은 HS256 서명 키라 32바이트 이상이어야 한다.
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# ── 웹 계층 ─────────────────────────────────────────────────
# [사용 중] refresh 쿠키의 Secure 속성. 로컬은 http 라 false, 배포는 true.
COOKIE_SECURE=false
# [사용 중] 쿠키를 주고받아야 해서 프론트 오리진을 명시한다. 콤마로 여러 개.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── 온체인 (SSAFY 네트워크) ──────────────────────────────────
# 이 체인은 가스가 공짜다(gasPrice 0). 잔액 0 인 주소로도 배포·전송이 된다 —
# 가스 토큰을 지급받아야 한다는 얘기는 사실이 아니었다. SSF 토큰은 체인 위에 얹힌
# 별개의 ERC-20 이지 네이티브 코인이 아니다. 릴레이어 키는 절대 커밋하지 않는다.
#
# ⚠️ 컨트랙트 · 키는 환경마다 한 벌이다(ANT-CHAIN-12) — 표는 contracts/deployments/README.md.
#   이 파일(로컬)은 항상 **dev** 한 벌을 쓴다. 운영(prod) 값은 여기 넣지 않는다 — .gitlab-ci.yml 이 넣는다.
#   dev 한 벌:  CONTRACT_COMMIT_ANCHOR=0x07f8CfE2bc6174D62BE8226E5e8699ffBf0d6D6a  (INDEXER_FROM_BLOCK=11186682)
#               CONTRACT_PREDICT_TOKEN=0xe11d728b157240DCf4a8c831176D248BAFD33077
#               릴레이어 키 = 0xb7f2…2a47 의 키 · 관리자 키 = 0x22B5…DEA1 의 키 (체인 담당에게 받는다)
#   dev 키로는 운영 컨트랙트를 못 움직인다(역할이 없다). 서버 부팅 로그 "체인 환경 확인" 에 ✓/✗ 로 찍힌다.
#   아래 CONTRACT_* 는 비워 둔다 — 비우면 그 기능만 꺼진다. 로컬에서 체인 기능이 필요할 때만 위 값을 채운다.
#
# [예정] 공개된 RPC 는 웹소켓 하나뿐이다. HTTP 엔드포인트는 확인되지 않았다.
CHAIN_RPC_URL=wss://ws.ssafy-blockchain.com
# [사용 중] SignatureGuard 가 EIP-191 서명 payload 에 박는다. 값이 틀리면 서명 검증이 깨진다.
# 31221 = SSAFY 네트워크. 로컬 Hardhat 으로 개발할 때는 31337 로 바꾼다
# (코드 기본값도 31337 이라, 이 줄을 비우면 로컬 Hardhat 을 가리킨다).
CHAIN_ID=31221
# [사용 중] 앵커 tx 를 보내는 서버 키(ANT-CHAIN-05). CommitAnchor 의 ANCHOR_ROLE 만 갖는다.
# 이 키가 새도 관리자 키로 revoke/grant 하면 재배포 없이 끝난다. 생성은 contracts 에서 `npm run keygen`.
RELAYER_PRIVATE_KEY=
# [배포 스크립트 전용] CommitAnchor 관리자 키(DEFAULT_ADMIN_ROLE). 서버 코드는 읽지 않는다 —
# contracts/scripts/deploy-ssafy.mjs 와 릴레이어 키 교체(grantRole/revokeRole)에만 쓴다.
# 원칙은 서버 밖 보관이지만 개발망(가스 0·자산 0)이라 .env 에 둔다. 운영 전환 시 옮긴다(contracts/README.md "키 두 개").
ANCHOR_ADMIN_PRIVATE_KEY=
# [사용 중] PredictTokenProperties — 자체 ANT 토큰 컨트랙트(ANT-CHAIN-03, 토큰증권 API 대신 자체 배포).
# 비워 두면 토큰 기능만 꺼지고 서버는 정상 부팅한다. 값은 contracts/deployments/dev/PredictToken.json.
# 단위는 decimals 0 — 1 ANT 가 최소 단위, 1 ANT = 1 원 상당. 금액 컬럼(numeric(30,0))·API 문자열에 그대로 정수가 들어간다.
# 오퍼레이터(mint·burn·subscribe)는 RELAYER_PRIVATE_KEY 의 주소와 같다. 이 컨트랙트는 재배포를 계획하지 않는다 —
# 잔액이 이 주소에 산다. 기능 확장은 위성 컨트랙트 + MOVER_ROLE(contracts/README.md "PredictToken").
CONTRACT_PREDICT_TOKEN=
# [배포 스크립트 전용] 플랫폼 30% 수납 주소의 키. 서버 코드는 읽지 않는다. 수납 주소는 컨트랙트가 기억하고(treasury())
# 관리자만 바꿀 수 있다. 관리자 키와 같은 이유로 개발망에서는 .env 에 둔다. 생성은 `npm run keygen treasury`.
TOKEN_TREASURY_PRIVATE_KEY=
# [사용 중] CommitAnchorProperties. 비워 두면 앵커 기능만 꺼지고 서버는 정상 부팅한다.
# 값은 contracts/deployments/dev/CommitAnchor.json (배포할 때마다 기록된다).
# ⚠️ v2(ANT-CHAIN-08) 주소를 넣어라. v1 배포본은 ABI(anchor 시그니처)가 달라 첫 앵커가 revert 한다.
CONTRACT_COMMIT_ANCHOR=
CONTRACT_PREDICTION_CERTIFICATE=
# [사용 중] 일일 앵커 배치(ANT-CHAIN-02). 기본값은 매일 00:05 KST(주말 포함)이고 "-" 로 끈다.
# ⚠️ 여기를 "-" 로 두는 이유: RELAYER_PRIVATE_KEY 와 CONTRACT_COMMIT_ANCHOR 를 채우는 순간
# 이 스케줄러가 조용히 켜져 팀 공용 컨트랙트로 실제 tx 를 보낸다. batchId 는 내 로컬 DB 의
# anchor_batches.id 라서, 로컬이 먼저 태운 번호를 나중에 다른 DB 가 쓰면 BATCH_ID_COLLISION 으로
# 영구히 막힌다(덮어쓰기가 없는 컨트랙트라 재배포뿐 — contracts/README.md 함정 2).
# 실제로 앵커를 돌릴 때만 이 줄을 지우거나(기본값 복귀) 크론식을 넣는다(확인용 예: 0 */2 * * * *).
# 빈 값("ANCHOR_CRON=")은 금지 — 기본값이 아니라 빈 cron 이 되어 기동이 깨진다.
ANCHOR_CRON=-
# [사용 중] 앵커 인덱서(ANT-CHAIN-04). CHAIN_RPC_URL + CONTRACT_COMMIT_ANCHOR 만 있으면 돈다(릴레이어 키 불필요, 읽기 전용).
# chain_events 가 비어 있을 때 Anchored 로그를 어느 블록부터 훑을지. SSAFY 는 컨트랙트 배포 블록
# (contracts/deployments/dev/CommitAnchor.json 의 blockNumber, v2 = 11186682)을 넣어라 — 0 이면 제네시스부터 1만 블록씩 1,100회를 훑는다.
# 로컬에서 켜 두면 팀 공용 컨트랙트의 이벤트를 내 DB 에 적재한다 — 쓰기는 없으니 무해하지만, 내 DB 에 없는
# batchId 는 "DB 에 없는 배치" 경고로 남는다(정상).
INDEXER_FROM_BLOCK=11186682
# 폴링 주기(스프링 cron). 기본 5초. "-" 로 끈다.
INDEXER_CRON=*/5 * * * * *

# ── 외부 데이터 ──────────────────────────────────────────────
# [사용 중] 공공데이터포털 「금융위원회_주식시세정보」. 날짜(basDt)별로 수집한다.
# 포털 마이페이지가 인증키를 Encoding/Decoding 두 벌로 준다 — 여기에는 Decoding 키를 넣는다.
# 코드가 한 번 더 인코딩하므로 Encoding 키를 넣으면 두 번 인코딩돼 인증에 실패한다.
# 비어 있으면 13시 수집 배치가 로그 한 줄만 남기고 건너뛴다 — 키가 없어도 앱은 그대로 뜬다.
PUBLIC_DATA_SERVICE_KEY=
# [사용 중] 백필 스위치. 과거 시세를 채울 때만 아래 주석을 풀고 재기동한다 —
# 2분마다 20영업일씩, 2020-01-02부터 어제까지 약 세 시간. 끝나면 도로 주석 처리.
# ⚠️ "BACKFILL_CRON=" 처럼 빈 값으로 두면 안 된다 — 빈 cron 이 되어 기동이 깨진다.
# BACKFILL_CRON=0 */2 * * * *
# [사용 중] 한국수출입은행 환율 Open API(ANT-DATA-04). koreaexim.go.kr > Open API 에서 발급한다.
# 인증키에 개인정보 보유기간이 있어 만료되면 재발급해야 한다 — 응답 result 3 이 그 신호다.
# 비어 있으면 14시 지수 수집 회차가 환율만 건너뛴다. 코스피·코스닥 지수는 위 포털 키로 받는다
# (포털 마이페이지에서 「금융위원회_지수시세정보」 활용신청이 따로 필요하다).
KOREAEXIM_AUTH_KEY=
# [사용 중] DART 전자공시 OpenAPI. 기업개황·연간 재무·공시 목록을 수집한다(ANT-RESEARCH-01).
# open.dart.fss.or.kr 에서 이메일 인증만으로 무료 발급된다(40자리 hex).
# 비어 있으면 네 갈래 수집이 전부 로그 한 줄만 남기고 건너뛴다 — 키가 없어도 앱은 그대로 뜬다.
# 실패가 HTTP 상태로 오지 않는다. 키가 틀려도 200 이고 본문 status 로만 구분되므로,
# 잘못된 키를 넣으면 "수집은 도는데 아무것도 안 쌓이는" 상태가 된다. 차라리 비워 두는 편이 낫다.
DART_API_KEY=

# ── AI ──────────────────────────────────────────────────────
# [사용 중] SSAFY GMS 게이트웨이(gms.ssafy.io). OpenAI Chat Completions 를 그대로 프록시한다 —
# 요청·응답 모양이 OpenAI 규격과 같고 주소만 앞단이 다르다. 인증은 Authorization: Bearer 다.
# 시장 브리핑 배치(B6)·투자 포인트(예측 탭에서 요청한 종목만)·복기 리포트가 이 키를 쓴다.
# 비어 있으면 생성 배치가 로그 한 줄만 남기고 건너뛴다 — 수집과 조회는 그대로 돈다.
# 수치는 코드가 계산하고 AI 는 서술 문단만 만든다.
AI_API_KEY=
# 모델 ID. 비우면 gpt-5.4-mini 를 쓴다. 게이트웨이가 날짜 붙은 실제 버전으로 해석해 준다.
AI_MODEL=
# 엔드포인트. 비우면 GMS. OpenAI Chat Completions 규격이면 어디든 — 코드는 그대로다.
#   Gemini 무료 티어(Flash·Flash-Lite · 15 RPM · 1,500 RPD 안팎 · 카드 없음)로 돌리려면 셋을 함께:
#     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     AI_API_KEY=<Google AI Studio 에서 발급한 키>
#     AI_MODEL=gemini-3.5-flash-lite      (2026-09 기준. 무료 대상 모델·한도는 AI Studio 콘솔에서 확인)
#   429(분당 한도)는 5초 쉬고 한 번 더 부른다. 무료 티어는 입력을 학습에 쓴다 — 우리 입력은
#   공개 시세·뉴스 발췌뿐이고 사용자 데이터가 없어 괜찮다.
AI_BASE_URL=

# ── 자체 서빙 LLM (교내 GPU · 뉴스 관련도 판정 전용) ──────────
# [선택] 비어 있으면 관련도 배치를 건너뛴다 — 재료 선정이 스포츠 어휘 정규식으로 떨어진다.
# 위 AI_* 와 나눈 이유: 기사 한 건에 한 콜이라 하루 1,000콜을 넘겨 무료 티어 한도를 넘는데,
# 판정은 "관련"/"무관" 한 낱말이라 자체 서빙 모델로 충분하다. 문장 생성은 위쪽이 계속 맡는다.
#
# GPU 박스(JupyterLab 터미널)에서 — 우리 코드는 올리지 않는다. vLLM 이 OpenAI 규격 서버다.
#
# GPU 는 팀 배정 3번이다 — nvidia-smi 가 매기는 번호(0·1·2·3) 그대로 3. 팀 안에서는 이걸
# "3번 터널" 이라고 부른다(ssh 터널과 다른 말이다). 1 은 다른 팀 vLLM 이 쓰고 있다.
#
# 반드시 tmux 안에서, -d(떼어 둔 채)로, 죽으면 다시 뜨게 루프로 띄운다. JupyterLab 터미널 탭에서
# 직접 돌리면 탭이 닫히거나 JupyterHub 가 세션을 정리할 때 함께 죽고, 로그도 남지 않는다
# (2026-09-11 에 그렇게 죽은 채로 발견됐다 — tmux 세션은 살아 있는데 안에 vLLM 이 없었다):
#   tmux new -d -s vllm 'source ~/vllm/bin/activate; while true; do CUDA_VISIBLE_DEVICES=3 \
#     vllm serve Qwen/Qwen2.5-32B-Instruct-AWQ --port 8100 --api-key antenna-gpu \
#     --served-model-name antenna --max-model-len 8192 --gpu-memory-utilization 0.85 \
#     2>&1 | tee -a ~/vllm.log; sleep 10; done'
# 로드에 3~5분. 떴는지는 GPU 박스에서 이것으로 본다(200). 터널이 붙어 있다고 vLLM 이 살아
# 있는 것이 아니다 — 역터널은 요청이 올 때에야 반대편에 붙어 보므로 받는 쪽이 죽어도 멀쩡해 보인다:
#   curl -s -o /dev/null -w '%{http_code}\n' -H "Authorization: Bearer <키>" localhost:8100/v1/models
#
# EC2 에서 교내망(70.12.130.105)으로 들어갈 수 없어 GPU 쪽에서 역터널을 건다(운영용):
#   tmux new -d -s tunnel 'while true; do ssh -i ~/J15A507T.pem -o StrictHostKeyChecking=no \
#     -o ServerAliveInterval=30 -o ExitOnForwardFailure=yes \
#     -N -R 0.0.0.0:8100:localhost:8100 ubuntu@j15a507.p.ssafy.io; sleep 5; done'
# 로컬에서 임시 공개 URL 로 시험할 때는 세션 이름을 반드시 갈라 쓴다. 같은 이름(tunnel)으로
# 띄우면 앞의 kill-session 이 운영 역터널을 조용히 죽인다:
#   tmux new -d -s tunnel-dev "ssh -o StrictHostKeyChecking=no -R 80:localhost:8100 nokey@localhost.run"
# EC2 쪽 준비 세 가지. 하나라도 빠지면 컨테이너에서 연결이 조용히 타임아웃된다.
#   1) /etc/ssh/sshd_config 에 GatewayPorts clientspecified (+ sudo systemctl reload ssh).
#      없으면 역터널이 127.0.0.1 에만 물려 도커 브리지에서 못 닿는다. 확인은 EC2 에서
#      ss -ltn | grep 8100 — 0.0.0.0:8100 이어야 한다.
#   2) docker-compose.prod.yml backend 의 extra_hosts (커밋돼 있다). 리눅스 도커에는
#      host.docker.internal 이 기본으로 없다.
#   3) ufw 허용. EC2 의 INPUT 정책이 DROP 이라 컨테이너 → 호스트 8100 이 막힌다:
#        sudo ufw allow from 172.18.0.0/16 to any port 8100 proto tcp   # compose 네트워크
#        sudo ufw allow from 172.17.0.0/16 to any port 8100 proto tcp   # 기본 브리지(임시 테스트용)
#      서브넷은 ip -4 -o addr show | grep -E 'docker0|br-' 로 확인한다. 172.16.0.0/12 통짜로
#      열지 않는다 — VPC(172.26.x)가 그 안이라 같은 대역의 다른 인스턴스까지 8100 에 닿는다.
# 확인 — 배포 전에 backend 가 탈 경로 그대로 쏴 본다(200 이어야 한다):
#   docker run --rm --network antenna_default --add-host host.docker.internal:host-gateway \
#     curlimages/curl -s -o /dev/null -w '%{http_code}\n' -H "Authorization: Bearer <키>" \
#     http://host.docker.internal:8100/v1/models
# 보안그룹에서 8100 을 열지 않으면 외부에 노출되지 않는다.
AI_GPU_API_KEY=
#   로컬에서 임시 터널(localhost.run)로 시험할 때는 https://<...>.lhr.life/v1
#   EC2 배포에서는 http://host.docker.internal:8100/v1
AI_GPU_BASE_URL=
# vLLM --served-model-name 값. 비우면 antenna.
AI_GPU_MODEL=
# 판정 배치 시각. 비우면 꺼진 채로 둔다. 터널이 상시로 선 뒤 "0 0 21 * * *" 로 켠다.
AI_GPU_RELEVANCE_CRON=

# ── 네이버 뉴스 (NAVER API HUB) ──────────────────────────────
# [사용 중] 뉴스 원천(ANT-RESEARCH-02). ncloud 콘솔 > NAVER API HUB 에서 발급한다.
# ⚠️ 구 네이버 개발자센터의 검색 API 가 아니다. 네이버가 검색 API 를 NAVER API HUB
# (네이버 클라우드 플랫폼)로 옮기면서 주소와 헤더가 모두 바뀌었다 —
# X-Naver-Client-Id/Secret 이 아니라 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY 다.
# 옛 문서를 보고 헤더를 맞추면 매 호출이 401 로 돌아온다.
# 둘 중 하나라도 비어 있으면 뉴스 수집을 건너뛴다.
NAVER_API_KEY_ID=
NAVER_API_KEY=

# ── SSAFY 금융망 / 토큰증권 ──────────────────────────────────
# [예정] 금융망(finopenapi.ssafy.io). 모든 요청 BODY 의 공통 Header 에 apiKey 가 들어간다.
# apiKey 는 개발자센터에서 발급받은 32자리 hex(UUID). 사용자별 userKey 는
# /ssafy/api/v1/member 회원가입 API 응답으로 받아 users 테이블에 보관한다.
SSAFY_FIN_BASE_URL=https://finopenapi.ssafy.io
SSAFY_FIN_API_KEY=

# [예정] 토큰증권(sto.ssafy.io). API KEY 가 없다 — 조회는 무인증,
# 상태변경 API 는 요청 본문에 지갑 서명(EIP-191)을 넣어 인가한다.
STO_BASE_URL=https://sto.ssafy.io
