# 백엔드 전용 환경변수. 복사해서 backend/.env 로 만들어 쓰고, .env 는 커밋하지 않는다.
# 프론트 값은 frontend/.env 에 따로 둔다. 루트에는 .env 를 만들지 않는다.
#
# [사용 중] = 지금 코드가 실제로 읽는 값
# [예정]   = 스키마·아키텍처상 필요한 값. 해당 기능을 붙일 때 application.yaml 에 연결한다.

# ── PostgreSQL ──────────────────────────────────────────────
# [사용 중] application.yaml 의 datasource. 컨테이너는 루트 docker-compose.yml 이 띄운다.
# compose 는 루트 .env 가 없으면 자기 기본값(antenna/antenna/antenna:5432)을 쓴다.
# 아래 값을 바꾸면 compose 쪽 기본값도 같이 바꿔야 서버와 컨테이너가 어긋나지 않는다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=antenna
DB_USER=antenna
DB_PASSWORD=antenna

# ── Redis ───────────────────────────────────────────────────
# [사용 중] refresh token 회전, 랭킹 스냅샷 캐시.
REDIS_HOST=localhost
REDIS_PORT=6379

# ── OAuth 2.0 로그인 ─────────────────────────────────────────
# [사용 중] 자체 회원가입은 만들지 않는다. 구글·SSAFY 두 종류뿐.
# 구글은 Cloud Console > 인증 플랫폼 > 클라이언트에서 발급한다.
# 리디렉션 URI 는 프론트 콜백(http://localhost:5173/oauth/callback/google)으로 등록한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [사용 중] 개발자센터 [내 어플리케이션] > [서비스 설정] > [SSAFY 로그인] 의 값이다.
# OPEN API Key 와 다른 자격증명이니 헷갈리지 말 것. Secret 에는 만료일이 있다.
# 주소·응답 필드명은 문서로 확정돼 application.yaml 에 상수로 들어갔다 —
# 환경마다 달라지는 값이 아니라 여기서 받지 않는다.
SSAFY_CLIENT_ID=
SSAFY_CLIENT_SECRET=

# ── 자체 발급 JWT ────────────────────────────────────────────
# [사용 중] access token 은 서버에 저장하지 않고, refresh token 만 Redis 에 둔다.
# JWT_SECRET 은 HS256 서명 키라 32바이트 이상이어야 한다.
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# ── 웹 계층 ─────────────────────────────────────────────────
# [사용 중] refresh 쿠키의 Secure 속성. 로컬은 http 라 false, 배포는 true.
COOKIE_SECURE=false
# [사용 중] 쿠키를 주고받아야 해서 프론트 오리진을 명시한다. 콤마로 여러 개.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── 온체인 (SSAFY 네트워크) ──────────────────────────────────
# 이 체인은 가스가 공짜다(gasPrice 0). 잔액 0 인 주소로도 배포·전송이 된다 —
# 가스 토큰을 지급받아야 한다는 얘기는 사실이 아니었다. SSF 토큰은 체인 위에 얹힌
# 별개의 ERC-20 이지 네이티브 코인이 아니다. 릴레이어 키는 절대 커밋하지 않는다.
#
# [예정] 공개된 RPC 는 웹소켓 하나뿐이다. HTTP 엔드포인트는 확인되지 않았다.
CHAIN_RPC_URL=wss://ws.ssafy-blockchain.com
# [사용 중] SignatureGuard 가 EIP-191 서명 payload 에 박는다. 값이 틀리면 서명 검증이 깨진다.
# 31221 = SSAFY 네트워크. 로컬 Hardhat 으로 개발할 때는 31337 로 바꾼다
# (코드 기본값도 31337 이라, 이 줄을 비우면 로컬 Hardhat 을 가리킨다).
CHAIN_ID=31221
# [예정] 앵커 tx 를 보내는 서버 키. CommitAnchor 의 ANCHOR_ROLE 만 갖는다 — 관리자 키(DEFAULT_ADMIN_ROLE)는
# 따로 만들어 서버 밖에 둔다(contracts/README.md "키 두 개"). 이 키가 새도 관리자 키로 revoke/grant 하면 재배포 없이 끝난다.
# 생성은 contracts 에서 `npm run keygen`. 릴레이어(ANT-CHAIN-05)가 붙을 때 application.yaml 에 연결한다.
RELAYER_PRIVATE_KEY=
# [예정] 자체 ANT 토큰 컨트랙트 (2026-09-04 결정: 토큰증권 API 대신 자체 배포).
CONTRACT_PREDICT_TOKEN=
# [사용 중] CommitAnchorProperties. 비워 두면 앵커 기능만 꺼지고 서버는 정상 부팅한다.
# 값은 contracts/deployments/<network>.json 에 배포할 때마다 기록된다.
# ⚠️ v2(ANT-CHAIN-08) 주소를 넣어라. v1 배포본은 ABI(anchor 시그니처)가 달라 첫 앵커가 revert 한다.
CONTRACT_COMMIT_ANCHOR=
CONTRACT_PREDICTION_CERTIFICATE=

# ── 외부 데이터 ──────────────────────────────────────────────
# [사용 중] 공공데이터포털 「금융위원회_주식시세정보」. 날짜(basDt)별로 수집한다.
# 포털 마이페이지가 인증키를 Encoding/Decoding 두 벌로 준다 — 여기에는 Decoding 키를 넣는다.
# 코드가 한 번 더 인코딩하므로 Encoding 키를 넣으면 두 번 인코딩돼 인증에 실패한다.
# 비어 있으면 13시 수집 배치가 로그 한 줄만 남기고 건너뛴다 — 키가 없어도 앱은 그대로 뜬다.
PUBLIC_DATA_SERVICE_KEY=
# [사용 중] 백필 스위치. 과거 시세를 채울 때만 아래 주석을 풀고 재기동한다 —
# 2분마다 20영업일씩, 2020-01-02부터 어제까지 약 세 시간. 끝나면 도로 주석 처리.
# ⚠️ "BACKFILL_CRON=" 처럼 빈 값으로 두면 안 된다 — 빈 cron 이 되어 기동이 깨진다.
# BACKFILL_CRON=0 */2 * * * *
# [사용 중] 한국수출입은행 환율 Open API(ANT-DATA-04). koreaexim.go.kr > Open API 에서 발급한다.
# 인증키에 개인정보 보유기간이 있어 만료되면 재발급해야 한다 — 응답 result 3 이 그 신호다.
# 비어 있으면 14시 지수 수집 회차가 환율만 건너뛴다. 코스피·코스닥 지수는 위 포털 키로 받는다
# (포털 마이페이지에서 「금융위원회_지수시세정보」 활용신청이 따로 필요하다).
KOREAEXIM_AUTH_KEY=
# [사용 중] DART 전자공시 OpenAPI. 기업개황·연간 재무·공시 목록을 수집한다(ANT-RESEARCH-01).
# open.dart.fss.or.kr 에서 이메일 인증만으로 무료 발급된다(40자리 hex).
# 비어 있으면 네 갈래 수집이 전부 로그 한 줄만 남기고 건너뛴다 — 키가 없어도 앱은 그대로 뜬다.
# 실패가 HTTP 상태로 오지 않는다. 키가 틀려도 200 이고 본문 status 로만 구분되므로,
# 잘못된 키를 넣으면 "수집은 도는데 아무것도 안 쌓이는" 상태가 된다. 차라리 비워 두는 편이 낫다.
DART_API_KEY=

# ── AI ──────────────────────────────────────────────────────
# [사용 중] SSAFY GMS 게이트웨이(gms.ssafy.io). OpenAI Chat Completions 를 그대로 프록시한다 —
# 요청·응답 모양이 OpenAI 규격과 같고 주소만 앞단이 다르다. 인증은 Authorization: Bearer 다.
# 배치 B6(뉴스 요약·AI 브리핑·투자 포인트·복기 리포트)만 이 키를 쓴다.
# 비어 있으면 생성 배치가 로그 한 줄만 남기고 건너뛴다 — 수집과 조회는 그대로 돈다.
# 수치는 코드가 계산하고 AI 는 서술 문단만 만든다.
AI_API_KEY=
# 모델 ID. 비우면 gpt-5.4-mini 를 쓴다. 게이트웨이가 날짜 붙은 실제 버전으로 해석해 준다.
AI_MODEL=

# ── 네이버 뉴스 (NAVER API HUB) ──────────────────────────────
# [사용 중] 뉴스 원천(ANT-RESEARCH-02). ncloud 콘솔 > NAVER API HUB 에서 발급한다.
# ⚠️ 구 네이버 개발자센터의 검색 API 가 아니다. 네이버가 검색 API 를 NAVER API HUB
# (네이버 클라우드 플랫폼)로 옮기면서 주소와 헤더가 모두 바뀌었다 —
# X-Naver-Client-Id/Secret 이 아니라 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY 다.
# 옛 문서를 보고 헤더를 맞추면 매 호출이 401 로 돌아온다.
# 둘 중 하나라도 비어 있으면 뉴스 수집을 건너뛴다.
NAVER_API_KEY_ID=
NAVER_API_KEY=

# ── SSAFY 금융망 / 토큰증권 ──────────────────────────────────
# [예정] 금융망(finopenapi.ssafy.io). 모든 요청 BODY 의 공통 Header 에 apiKey 가 들어간다.
# apiKey 는 개발자센터에서 발급받은 32자리 hex(UUID). 사용자별 userKey 는
# /ssafy/api/v1/member 회원가입 API 응답으로 받아 users 테이블에 보관한다.
SSAFY_FIN_BASE_URL=https://finopenapi.ssafy.io
SSAFY_FIN_API_KEY=

# [예정] 토큰증권(sto.ssafy.io). API KEY 가 없다 — 조회는 무인증,
# 상태변경 API 는 요청 본문에 지갑 서명(EIP-191)을 넣어 인가한다.
STO_BASE_URL=https://sto.ssafy.io
