# docker-compose.yml 과 백엔드가 함께 읽는 값.
# 복사해서 .env 로 만들어 쓰고, .env 는 커밋하지 않는다.
#
# [사용 중] = 지금 코드가 실제로 읽는 값
# [예정]   = 스키마·아키텍처상 필요한 값. 해당 기능을 붙일 때 application.yaml 에 연결한다.

# ── PostgreSQL ──────────────────────────────────────────────
# [사용 중] compose 가 컨테이너를, application.yaml 이 datasource 를 만든다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=antenna
DB_USER=antenna
DB_PASSWORD=antenna

# ── Redis ───────────────────────────────────────────────────
# [사용 중] refresh token 회전, 랭킹 스냅샷 캐시.
REDIS_HOST=localhost
REDIS_PORT=6379

# ── OAuth 2.0 로그인 ─────────────────────────────────────────
# [예정] 자체 회원가입은 만들지 않는다. 구글·SSAFY 두 종류뿐.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SSAFY 는 OIDC discovery 가 없을 수 있어 엔드포인트를 직접 넣는다.
# 개발자센터 승인 후 실제 스펙으로 채울 것.
SSAFY_CLIENT_ID=
SSAFY_CLIENT_SECRET=
SSAFY_AUTHORIZATION_URI=
SSAFY_TOKEN_URI=
SSAFY_USER_INFO_URI=
SSAFY_USER_NAME_ATTRIBUTE=

# ── 자체 발급 JWT ────────────────────────────────────────────
# [예정] access token 은 서버에 저장하지 않고, refresh token 만 Redis 에 둔다.
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# ── 온체인 (SSAFY 네트워크) ──────────────────────────────────
# [예정] 가스 토큰은 SSAFY 지급분을 쓴다. 릴레이어 키는 절대 커밋하지 않는다.
CHAIN_RPC_URL=
CHAIN_ID=
RELAYER_PRIVATE_KEY=
CONTRACT_PREDICT_TOKEN=
CONTRACT_COMMIT_ANCHOR=
CONTRACT_PREDICTION_CERTIFICATE=

# ── 외부 데이터 ──────────────────────────────────────────────
# [예정] 공공데이터포털 「금융위원회_주식시세정보」. 날짜(basDt)별로 수집한다.
PUBLIC_DATA_SERVICE_KEY=
# [예정] DART 공시. AI 리포트 재료이며 도입 여부는 아직 미결정.
DART_API_KEY=

# ── AI ──────────────────────────────────────────────────────
# [예정] 제공자 미확정. 수치는 코드가 계산하고 AI 는 서술 문단만 만든다.
AI_API_KEY=
AI_MODEL=
